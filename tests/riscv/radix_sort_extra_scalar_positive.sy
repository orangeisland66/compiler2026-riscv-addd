const int DIGITS = 8;

int select_digit_extra(int value, int position, int context) {
  int power = 1;
  int level = 0;
  int unused;
  ;
  while (level < position) {
    value = value / DIGITS;
    ;
    level = level + 1;
  }
  return value % DIGITS;
}

void sort_by_digits_extra(int position, int values[], int begin, int end,
                          int __syc_radix_maximum) {
  int starts[DIGITS] = {};
  int limits[DIGITS] = {};
  int counts[DIGITS] = {};
  if (position == -1 || begin + 1 >= end)
    return;
  {
    int cursor = begin;
    while (cursor < end) {
      counts[select_digit_extra(values[cursor], position, 0)] =
          counts[select_digit_extra(values[cursor], position, 0)] + 1;
      cursor = cursor + 1;
    }
    starts[0] = begin;
    limits[0] = begin + counts[0];
    cursor = 1;
    while (cursor < DIGITS) {
      starts[cursor] = limits[cursor - 1];
      limits[cursor] = starts[cursor] + counts[cursor];
      cursor = cursor + 1;
    }
    cursor = 0;
    while (cursor < DIGITS) {
      while (starts[cursor] < limits[cursor]) {
        int value = values[starts[cursor]];
        while (select_digit_extra(value, position, 0) != cursor) {
          int temporary = value;
          value = values[starts[select_digit_extra(temporary, position, 0)]];
          values[starts[select_digit_extra(temporary, position, 0)]] =
              temporary;
          starts[select_digit_extra(temporary, position, 0)] =
              starts[select_digit_extra(temporary, position, 0)] + 1;
        }
        values[starts[cursor]] = value;
        starts[cursor] = starts[cursor] + 1;
      }
      cursor = cursor + 1;
    }
  }
  {
    int cursor = begin;
    starts[0] = begin;
    limits[0] = begin + counts[0];
    cursor = 0;
    while (cursor < DIGITS) {
      if (cursor > 0) {
        starts[cursor] = limits[cursor - 1];
        limits[cursor] = starts[cursor] + counts[cursor];
      }
      sort_by_digits_extra(position - 1, values, starts[cursor],
                           limits[cursor], 0);
      cursor = cursor + 1;
    }
  }
}

int __syc_radix_scratch[1];
int first_values_extra[64];
int second_values_extra[64];

int run_radix_extra(int count) {
  sort_by_digits_extra(3, first_values_extra, 0, count, count + 1);
  sort_by_digits_extra(3, second_values_extra, 0, count, count + 2);
  int cursor = 0;
  int checksum = 0;
  while (cursor < count) {
    checksum = checksum + first_values_extra[cursor] * (cursor + 1);
    checksum = checksum - second_values_extra[cursor] * (cursor + 3);
    cursor = cursor + 1;
  }
  return checksum;
}

int main() {
  int cursor = 0;
  __syc_radix_scratch[0] = 23;
  while (cursor < 64) {
    first_values_extra[cursor] = (cursor * 197 + 53) % 4096;
    second_values_extra[cursor] = (cursor * 313 + 91) % 4096;
    cursor = cursor + 1;
  }
  putint(run_radix_extra(64));
  putch(10);
  putint(run_radix_extra(0));
  putch(10);
  putint(run_radix_extra(1));
  putch(10);
  putint(__syc_radix_scratch[0]);
  putch(10);
  return 0;
}
