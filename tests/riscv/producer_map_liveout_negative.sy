const int KSIZE = 5;

int input_values[64];
int mapped_values[64];
int kernel[25];

int main() {
  int bound = getint();
  int repeat_bound = getint();

  int row = 0;
  while (row < bound) {
    int column = 0;
    while (column < bound) {
      input_values[row * bound + column] = row + column + 1;
      column = column + 1;
    }
    row = row + 1;
  }

  int kernel_index = 0;
  while (kernel_index < KSIZE * KSIZE) {
    kernel[kernel_index] = kernel_index % 3 - 1;
    kernel_index = kernel_index + 1;
  }

  int padding = KSIZE / 2;
  int repeat = 1;
  while (repeat < repeat_bound) {
    row = 0;
    while (row < bound) {
      int column = 0;
      while (column < bound) {
        int sum = 0;
        int kernel_row = 0;
        while (kernel_row < KSIZE) {
          int kernel_column = 0;
          int input_row = row + kernel_row - padding;
          while (kernel_column < KSIZE) {
            int input_column = column + kernel_column - padding;
            if (input_row >= 0 && input_row < bound &&
                input_column >= 0 && input_column < bound) {
              int input = input_values[input_row * bound + input_column];
              sum = sum +
                    input * kernel[kernel_row * KSIZE + kernel_column];
            }
            kernel_column = kernel_column + 1;
          }
          kernel_row = kernel_row + 1;
        }
        mapped_values[row * bound + column] = sum;
        column = column + 1;
      }
      row = row + 1;
    }
    repeat = repeat + 1;
  }

  int map_liveout = 0;
  int index = 0;
  while (index < bound * bound) {
    int value = mapped_values[index];
    mapped_values[index] = (value * value + 3 * value - 7) % 97;
    map_liveout = value;
    index = index + 1;
  }

  row = 0;
  while (row < bound) {
    int sum = 0;
    int column = 0;
    while (column < bound) {
      sum = sum + mapped_values[row * bound + column];
      column = column + 1;
    }
    column = 0;
    while (column < bound) {
      mapped_values[row * bound + column] =
          mapped_values[row * bound + column] - sum;
      column = column + 1;
    }
    row = row + 1;
  }

  int result = 0;
  index = 0;
  while (index < bound * bound) {
    result = result + mapped_values[index];
    index = index + 1;
  }
  putint(result + map_liveout);
  putch(10);
  return 0;
}
