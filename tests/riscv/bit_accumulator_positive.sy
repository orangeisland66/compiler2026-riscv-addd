int bit_and_renamed(int left, int right) {
  int result = 0;
  int power = 1;
  int length = 32;
  while (length != 0) {
    if ((left % 2 == 1) && (right % 2 == 1))
      result = result + power;
    left = left / 2;
    right = right / 2;
    power = power * 2;
    length = length - 1;
  }
  return result;
}

int main() {
  putint(bit_and_renamed(13, 11));
  putch(10);
  return 0;
}
