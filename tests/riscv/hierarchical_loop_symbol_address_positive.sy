// 构造嵌套链式遍历，检查同一全局数组地址能否逐层移出循环。
int node_labels[32];
int node_links[32];
int node_values[32];
int child_links[32];

int sum_linked_values(int wanted) {
  int node = 1;
  int result = 0;
  while (node != 0) {
    if (node_labels[node] == wanted && node_values[node] >= 0) {
      int child = node;
      int sum = 0;
      while (child != 0) {
        sum = sum + node_values[child];
        child = child_links[child];
      }
      result = result + sum;
    }
    node = node_links[node];
  }
  return result;
}

int main() {
  int bound = getint();
  int index = 1;
  while (index <= bound) {
    node_labels[index] = index;
    node_values[index] = index;
    child_links[index] = 0;
    if (index < bound) {
      node_links[index] = index + 1;
    } else {
      node_links[index] = 0;
    }
    index = index + 1;
  }

  putint(sum_linked_values(bound));
  putch(10);
  return 0;
}
