int choose_complement(int value, int marker) {
  int result;
  if (value == marker) {
    result = value;
  } else {
    result = 0 - value - 1;
  }
  return result;
}

int main() {
  int selector = getint();
  int value;
  if (selector == 0) {
    value = getint();
  } else {
    value = getint();
  }
  int marker = getint();
  putint(choose_complement(value, marker));
  return 0;
}
