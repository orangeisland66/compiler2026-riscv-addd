// 负例：模板采样区域还更新可观察计数器，不能只生成纯 stencil interior 快路径。
const int STENCIL_SIZE = 5;
int stencil_bound;
int stencil_input[64];
int stencil_output[64];
int stencil_kernel[25];
int stencil_counter;

int main() {
  stencil_bound = getint();
  int row = 0;
  while (row < stencil_bound) {
    int column = 0;
    while (column < stencil_bound) {
      stencil_input[row * stencil_bound + column] = row + column + 1;
      column = column + 1;
    }
    row = row + 1;
  }
  int kernel_index = 0;
  while (kernel_index < STENCIL_SIZE * STENCIL_SIZE) {
    stencil_kernel[kernel_index] = kernel_index % 3 - 1;
    kernel_index = kernel_index + 1;
  }
  int padding = STENCIL_SIZE / 2;
  row = 0;
  while (row < stencil_bound) {
    int column = 0;
    while (column < stencil_bound) {
      int sum = 0;
      int kernel_row = 0;
      while (kernel_row < STENCIL_SIZE) {
        int input_row = row + kernel_row - padding;
        int kernel_column = 0;
        while (kernel_column < STENCIL_SIZE) {
          int input_column = column + kernel_column - padding;
          if (input_row >= 0 && input_row < stencil_bound &&
              input_column >= 0 && input_column < stencil_bound) {
            sum = sum +
                  stencil_input[input_row * stencil_bound + input_column] *
                      stencil_kernel[kernel_row * STENCIL_SIZE + kernel_column];
            stencil_counter = stencil_counter + 1;
          }
          kernel_column = kernel_column + 1;
        }
        kernel_row = kernel_row + 1;
      }
      stencil_output[row * stencil_bound + column] = sum;
      column = column + 1;
    }
    row = row + 1;
  }
  putint(stencil_output[0] + stencil_counter);
  putch(10);
  return 0;
}
