// 文件职责：验证原地矩阵行归约在分块和尾部迭代下保持相同结果。
int source[10][10];
int state[10][10];

int main() {
  int n = 8;
  int i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      source[i][j] = ((i + 1) * (j + 2)) % 7 - 3;
      if (i == j) {
        state[i][j] = 1;
      } else {
        state[i][j] = (i + j) % 3 - 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      int total = 0;
      int k = 0;
      while (k < n) {
        total = total + source[i][k] * state[k][j];
        k = k + 1;
      }
      state[i][j] = total;
      j = j + 1;
    }
    i = i + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < n) {
    int j = 0;
    while (j < n) {
      checksum = checksum + state[i][j] * (i + j + 1);
      j = j + 1;
    }
    i = i + 1;
  }
  putint(checksum);
  putch(10);
  return 0;
}
