int scalar_store_boundary(int flag) {
  int values[1];
  values[0] = 0;
  int index = 0;
  while (index < 4) {
    values[0] = values[0] + index + 1;
    index = index + 1;
  }
  if (flag != 0)
    values[0] = 0;
  return values[0];
}

int main() {
  putint(scalar_store_boundary(0));
  putch(32);
  putint(scalar_store_boundary(1));
  putch(10);
  return 0;
}
