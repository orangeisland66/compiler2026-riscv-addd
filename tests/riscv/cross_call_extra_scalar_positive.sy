const int SIDE = 6;

void advance_rows_extra(int width, int factor[][SIDE], int input[][SIDE],
                        int output[][SIDE], int hint) {
  int column;
  int reduction;
  int row;

  row = 0;
  column = 0;
  while (row < width) {
    column = 0;
    while (column < width) {
      output[row][column] = 0;
      column = column + 1;
    }
    row = row + 1;
  }

  row = 0;
  column = 0;
  reduction = 0;
  while (reduction < width) {
    row = 0;
    while (row < width) {
      if (factor[row][reduction] == 1) {
        row = row + 1;
        continue;
      }
      column = 0;
      while (column < width) {
        output[row][column] = output[row][column] *
                              factor[row][reduction] +
                              input[reduction][column];
        column = column + 1;
      }
      row = row + 1;
    }
    reduction = reduction + 1;
  }
}

int run_extra_summary(int width, int repeat) {
  int factor[SIDE][SIDE];
  int data[SIDE][SIDE];
  int scratch[SIDE][SIDE];
  int __syc_row_summary_a[SIDE];
  int row;
  int column;
  int round;
  int __syc_summary_round = 17;
  int answer = __syc_summary_round;

  __syc_row_summary_a[0] = 23;

  row = 0;
  while (row < width) {
    column = 0;
    while (column < width) {
      factor[row][column] = (row * 3 + column * 5) % 4 + 1;
      data[row][column] = row * 11 - column * 7 + 3;
      scratch[row][column] = 0;
      column = column + 1;
    }
    row = row + 1;
  }

  round = 0;
  while (round < repeat) {
    advance_rows_extra(width, factor, data, scratch, round + 1);
    advance_rows_extra(width, factor, scratch, data, round + 2);
    advance_rows_extra(width, factor, data, scratch, round + 3);
    advance_rows_extra(width, factor, scratch, data, round + 4);
    round = round + 1;
  }

  row = 0;
  while (row < width) {
    column = 0;
    while (column < width) {
      answer = answer + data[row][column];
      column = column + 1;
    }
    row = row + 1;
  }
  answer = answer + __syc_row_summary_a[0];
  return answer;
}

int main() {
  putint(run_extra_summary(4, 2));
  putch(10);
  return 0;
}
