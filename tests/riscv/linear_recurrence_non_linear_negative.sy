int recurrence_non_linear() {
  int index = 0;
  int first = 1;
  int second = 1;
  while (index < 64) {
    int next_first = first * second;
    int next_second = first;
    first = next_first;
    second = next_second;
    index = index + 1;
  }
  return first + second;
}

int main() {
  putint(recurrence_non_linear());
  putch(10);
  return 0;
}
