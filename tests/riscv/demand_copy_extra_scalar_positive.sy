int storage[128];

int reshape_lower_triangle_extra(int count, int values[], int row_width,
                                 int hint) {
  int column_width = count / row_width;
  int outer = 0;
  int inner = 0;
  int unused;
  while (outer < column_width) {
    inner = 0;
    ;
    while (inner < row_width) {
      if (outer < inner) {
        inner = inner + 1;
        continue;
      }
      int saved = values[outer * row_width + inner];
      values[inner * column_width + outer] =
          values[outer * row_width + inner];
      values[outer * row_width + inner] = saved;
      inner = inner + 1;
    }
    outer = outer + 1;
  }
  return -7;
}

int run_demand_extra(int count) {
  int shapes[3];
  int shape_count = 3;
  int cursor = 0;
  int __syc_demand_output = 9;
  int answer = 5 + __syc_demand_output;
  shapes[0] = 4;
  shapes[1] = 6;
  shapes[2] = 3;
  while (cursor < count) {
    storage[cursor] = cursor * 3 + 1;
    if (cursor % 7 == 2)
      storage[cursor] = cursor - 11;
    cursor = cursor + 1;
  }
  cursor = 0;
  while (cursor < shape_count) {
    reshape_lower_triangle_extra(count, storage, shapes[cursor], cursor + 1);
    ;
    cursor = cursor + 1;
  }
  cursor = 0;
  while (cursor < shape_count) {
    answer = answer + (cursor + 3) * storage[cursor] - cursor;
    ;
    cursor = cursor + 1;
  }
  return answer;
}

int main() {
  putint(run_demand_extra(24));
  putch(10);
  return 0;
