// 负例：数据量低于通用收益门槛时保留原循环，避免为小对象扩大代码和寄存器压力。
int small_grid[16][16];

int reorder_small(int total, int source[], int width) {
  int height = total / width;
  int row = 0;
  while (row < height) {
    int column = 0;
    while (column < width) {
      if (row < column) {
        column = column + 1;
        continue;
      }
      int old = source[row * width + column];
      source[column * height + row] = source[row * width + column];
      source[row * width + column] = old;
      column = column + 1;
    }
    row = row + 1;
  }
  return -1;
}

int main() {
  int cursor = 0;
  while (cursor < 256) {
    small_grid[cursor / 16][cursor % 16] = cursor;
    cursor = cursor + 1;
  }
  reorder_small(256, small_grid[0], 16);
  putint(small_grid[1][1]);
  putch(10);
  return 0;
}
