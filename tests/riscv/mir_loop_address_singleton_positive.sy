// 正例：循环内重复使用同一仿射数组地址，可提升基址并递推地址寄存器。
int address_samples[256];

int main() {
  int cursor = 0;
  while (cursor < 256) {
    address_samples[cursor] = cursor + 3;
    cursor = cursor + 1;
  }
  int total = 0;
  cursor = 0;
  while (cursor < 64) {
    total = total + address_samples[cursor * 2 + 1];
    cursor = cursor + 1;
  }
  putint(total);
  putch(10);
  return 0;
}
