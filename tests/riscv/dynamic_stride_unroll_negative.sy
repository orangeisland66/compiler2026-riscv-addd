// 动态步长展开遇到非正步长、零次迭代和单次迭代边界时保留原循环。
int f(int x) {
    return x * 3 + 1;
}

int loop(int s, int t, int d) {
    int sum = 0;
    int x = s;
    while (x < t) {
        sum = sum + f(x);
        x = x + d;
    }
    return sum;
}

int main() {
    putint(loop(1, 8, 3));
    putch(10);
    putint(loop(2, 10, 4));
    putch(10);
    putint(loop(10, 1, 0));
    putch(10);
    putint(loop(10, 1, -1));
    putch(10);
    putint(loop(2147483646, 2147483647, 1));
    putch(10);
    return 0;
}
