int state;

int f(int x) {
    state = state + 1;
    return x * 3 + 1;
}

int loop(int s, int t, int d) {
    int sum = 0;
    int x = s;
    while (x < t) {
        sum = (sum + f(x)) % 998244853;
        x = x + d;
    }
    return sum + state;
}

int main() {
    state = 0;
    putint(loop(1, 8, 3));
    putch(10);
    state = 0;
    putint(loop(2, 10, 4));
    putch(10);
    state = 0;
    putint(loop(10, 1, 0));
    putch(10);
    state = 0;
    putint(loop(10, 1, -1));
    putch(10);
    state = 0;
    putint(loop(2147483646, 2147483647, 1));
    putch(10);
    return 0;
}
